{
  "name": "sunline-defense",
  "version": "1.2.0",
  "private": false,
  "license": "MIT",
  "description": "阳光防线 — pixel garden defense. Fan-made Plants vs Zombies-inspired web game.",
  "author": "xinian5216",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinian5216/sunline-defense.git"
  },
  "bugs": {
    "url": "https://github.com/xinian5216/sunline-defense/issues"
  },
  "homepage": "https://xinian5216.github.io/sunline-defense/",
  "keywords": [
    "game",
    "tower-defense",
    "pixel-art",
    "react",
    "vite",
    "plants-vs-zombies",
    "canvas"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron-builder --publish never",
    "desktop:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "fun.sunline.defense",
    "productName": "阳光防线",
    "copyright": "Copyright © 2026 xinian5216",
    "electronVersion": "37.3.1",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "SunlineDefense-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "SunlineDefense-Setup-${version}.exe",
      "shortcutName": "阳光防线",
      "uninstallDisplayName": "阳光防线"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "SunlineDefense-macOS-${version}-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Game",
      "artifactName": "SunlineDefense-linux-${version}-${arch}.${ext}"
    }
  }
}
